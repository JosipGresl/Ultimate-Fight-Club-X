<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ultimate_Fight_Club_X.AddPaymentPage"
             Title="Nova uplata">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="{Binding MemberName}" FontSize="22" FontAttributes="Bold" />

        <Label Text="Iznos (EUR)" />
        <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="npr. 30" />

        <Label Text="Datum uplate" />
        <DatePicker Date="{Binding PaymentDate}" />

        <Label Text="Plaćeno za (mjeseci)" />
        <Picker ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonths}" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        <Button Text="Spremi uplatu" Command="{Binding SaveCommand}" />

    </VerticalStackLayout>
</ContentPage>