<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ultimate_Fight_Club_X.MembersPage"
             Title="Članovi">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">

        <Button Grid.Row="0"
        Text="Dodaj člana"
        Command="{Binding AddMemberCommand}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Members}"
                        SelectionMode="Single"
                        SelectionChanged="OnMemberSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="0,8">
                        <Label Text="{Binding FullName}" FontSize="18" />
                        <Label Text="{Binding Group}" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>