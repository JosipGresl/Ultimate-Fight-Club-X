<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ultimate_Fight_Club_X.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Ultimate_Fight_Club_X"
    Shell.FlyoutBehavior="Disabled"
    Title="Ultimate Fight Club X">

    <TabBar>
        <ShellContent Title="Članovi"
                      ContentTemplate="{DataTemplate local:MembersPage}"
                      Route="MembersPage" />
        <ShellContent Title="Dolasci"
                      ContentTemplate="{DataTemplate local:AttendancePage}"
                      Route="AttendancePage" />
        <ShellContent Title="Članarine"
              ContentTemplate="{DataTemplate local:FeesPage}"
              Route="FeesPage" />
    </TabBar>
</Shell>