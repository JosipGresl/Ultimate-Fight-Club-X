<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ultimate_Fight_Club_X.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Ultimate_Fight_Club_X"
    Shell.FlyoutBehavior="Disabled"
    Title="Ultimate Fight Club X"
    Shell.BackgroundColor="#0E0E10"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource BrandColor}, Dark={StaticResource BrandColorLight}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource BrandColor}, Dark={StaticResource BrandColorLight}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">

    <TabBar>
        <ShellContent Title="Članovi"
                      ContentTemplate="{DataTemplate local:MembersPage}"
                      Route="MembersPage" />
        <ShellContent Title="Dolasci"
                      ContentTemplate="{DataTemplate local:AttendancePage}"
                      Route="AttendancePage" />
        <ShellContent Title="Članarine"
              ContentTemplate="{DataTemplate local:FeesPage}"
              Route="FeesPage" />
        <ShellContent Title="Pregled"
              ContentTemplate="{DataTemplate local:DashboardPage}"
              Route="DashboardPage" />
    </TabBar>
</Shell>